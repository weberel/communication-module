# ecoTrace datalogger (ESP-IDF port) -- build-time configuration baseline.
# PlatformIO merges this into the generated sdkconfig on first build.

# ---- Flash / partitions ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- OTA with rollback (the reason this port owns field OTA) ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- Console over the C6's native USB Serial/JTAG ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- Task watchdog: long timeout, panic-reboot (proven policy from Arduino) ----
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=120
CONFIG_ESP_TASK_WDT_PANIC=y

# ---- Crash forensics into the coredump partition ----
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# ---- LP core (continuous sensor sampling -- headline feature of the port) ----
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=8192

# ---- mbedTLS: TLS 1.2 client, room for MQTTS ----
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y

# ---- PPP over the A7672 (esp_modem data mode) ----
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y

# Multi-server SNTP. uplink.c asks for two servers (time.google.com and
# pool.ntp.org); lwip defaults to ONE, so esp_netif_sntp_init() failed outright
# with "Tried to configure more servers than enabled in lwip" -- observed on
# hardware 2026-09-04. The clock was being carried entirely by the HTTPS-Date
# cross-check, i.e. the redundancy we thought we had did not exist.
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# CPU at 80 MHz instead of 160. A sampling wake is dominated by waiting -- I2C
# sensor conversions (LTR-303 150 ms, MS5837 60 ms), flash writes, rail settle
# -- not by computing, so halving the clock roughly halves active current for
# nearly the same elapsed time. The TLS handshake is the one compute-bound step
# and does get slower, but by seconds inside a session already dominated by the
# modem's attach time.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# Skip re-validating the app image on a DEEP-SLEEP wake. The bootloader
# otherwise SHA-256s the whole 1.2 MB application 288 times a day, and the only
# cost that matters on this node is ESP32 awake-milliseconds. Power-on boots and
# post-OTA boots still validate, which is where validation actually earns its
# keep -- this only skips the case where the image was already verified moments
# earlier and the chip never lost power.
# CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP -- NOT enabled: it makes the
# bootloader retain the image digest in RTC reserved memory, which overflows
# lp_reserved_seg by 16 bytes on this build. Worth ~1 mAh/day; not worth
# reshuffling the RTC memory layout for.

# Bootloader chatter costs formatting time on every wake; warnings and errors
# are still printed.
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
