# ecoTrace datalogger (ESP-IDF port) -- build-time configuration baseline.
# PlatformIO merges this into the generated sdkconfig on first build.

# ---- Flash / partitions ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- OTA with rollback (the reason this port owns field OTA) ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- Console over the C6's native USB Serial/JTAG ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- Task watchdog: long timeout, panic-reboot (proven policy from Arduino) ----
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=120
CONFIG_ESP_TASK_WDT_PANIC=y

# ---- Crash forensics into the coredump partition ----
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# ---- LP core (continuous sensor sampling -- headline feature of the port) ----
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=8192

# ---- mbedTLS: TLS 1.2 client, room for MQTTS ----
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y

# ---- PPP over the A7672 (esp_modem data mode) ----
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y

# Power management: FREQUENCY SCALING ONLY. Automatic light sleep is deliberately
# NOT enabled, and CONFIG_FREERTOS_USE_TICKLESS_IDLE is deliberately absent --
# esp_pm_configure() rejects light_sleep_enable without it, so leaving it out is
# a second, independent guarantee on top of the runtime flag.
#
# WHY, measured 2026-09-14. With PM restored exactly as it shipped on 09-07, the
# USB cable became the treatment variable, because light sleep was gated on
# !usb_present:
#     light sleep OFF (cable in):   0 of 11 records failed
#     light sleep ON  (cable out):  4 of 8  records failed   <- 50 %
#     Fisher exact one-tailed p = 0.018, against a 131-record baseline of zero.
# Every failure read sensor_ok = 15: bits 4 and 5 clear, i.e. USS and WF280A --
# exactly and only the two devices on the SWITCHED sensor rail. The likely
# mechanism is that gpio_hold_en(ECO_PIN_SENSOR_PWR) is applied only on the path
# into DEEP sleep, so during the 3 s BOARD_SENSOR_BOOT_MS settle -- 100x the
# 30 ms tickless threshold -- the rail enable is unheld while the core light
# sleeps, and the rail collapses under the module.
#
# It bought +0.1 uA. The real saving was gpio_pullup_dis (1467.5 -> 356.5 uA).
# DFS stayed clean for all 11 records with light sleep off, so it is kept.
CONFIG_PM_ENABLE=y

# A5, skip app validation on deep-sleep wake: NOT ENABLED -- it does not fit.
#
# Turning it on makes the bootloader cache the app entry point in RTC memory,
# and on this part that overflows:
#     section .rtc_reserved will not fit in region lp_reserved_seg
#     region lp_reserved_seg overflowed by 16 bytes
# Verified in isolation 2026-09-14: this line alone is the difference between a
# clean link and that error. Re-enabling it means finding 16 bytes in the RTC
# reserved segment, which is IDF-internal retain state, not ours to shrink.
# The prize was a few tens of ms of CPU per wake, so it is not worth the surgery.
# CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# ---- MQTT 5 ----
# Required by uplink.c (.session.protocol_ver = MQTT_PROTOCOL_V_5). Without it
# esp_mqtt_client_init() refuses outright -- "Please first enable
# MQTT_PROTOCOL_5 feature in menuconfig" -- and MQTT never comes up at all.
#
# Not cosmetic: on 3.1.1 a broker that REFUSES a publish still returns PUBACK,
# and publish_acked() advances the flash ring cursor on PUBACK, so a refused
# publish would silently discard records that never arrived. Reason code 0x87
# makes refusal visible.
#
# NOTE this file only SEEDS a fresh config; an existing sdkconfig.datalogger_idf
# wins, so that file was edited too.
CONFIG_MQTT_PROTOCOL_5=y
